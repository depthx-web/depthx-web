## Supabase (see README.md "Connecting the real CMS")
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
## Server-only, bypasses RLS entirely — never expose to the browser. Needed
## for /admin/users' "Add User" feature (Project Settings -> API -> service_role).
SUPABASE_SERVICE_ROLE_KEY=

## Revalidation webhook (Supabase Database Webhooks -> Vercel, on-demand ISR)
SUPABASE_REVALIDATE_SECRET=

## Email (contact replies + marketing campaigns — see README "Email sending")
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

## Site
NEXT_PUBLIC_SITE_URL=https://depthx.co.uk

## Analytics (Plausible — spec §7). Leave unset to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
